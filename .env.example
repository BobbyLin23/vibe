# Inngest v4 defaults to Cloud mode; local development talks to the dev server instead.
INNGEST_DEV=1

# DeepSeek key for the coding agent: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional: point the agent at an OpenAI-compatible gateway or a local test server
# instead of https://api.deepseek.com.
# DEEPSEEK_BASE_URL=http://127.0.0.1:8899

# E2B key for the sandbox the coding agent works in: https://e2b.dev/dashboard
E2B_API_KEY=

# Optional: E2B template the sandbox boots from instead of the SDK's `base` template,
# e.g. one that has Node and a dev server installed.
# E2B_TEMPLATE=

DATABASE_URL=""
